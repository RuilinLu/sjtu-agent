# Copy this file to .env and fill real values. Do not commit .env.

JACCOUNT_USERNAME=your_jaccount_username
JACCOUNT_PASSWORD=your_password

# Zhiyuan-1 / SJTU model platform.
ZHIYUAN_API_KEY=your-zhiyuan-api-key
ZHIYUAN_BASE_URL=https://models.sjtu.edu.cn/api/v1
ZHIYUAN_MODEL=deepseek-chat

# Optional: captcha helper for some setup/login flows.
ANTHROPIC_API_KEY=

# ClawBot/OpenClaw proactive push.
# Leave empty if OpenClaw has no webhook/push endpoint yet; MCP query tools still work.
OPENCLAW_PUSH_URL=
OPENCLAW_PUSH_TOKEN=
OPENCLAW_PUSH_TO=

# Student VPN values for deploy/clawbot-vpn.
SJTU_VPN_SERVER=stuv4.vpn.sjtu.edu.cn
SJTU_VPN_ID=@stu.vpn.sjtu.edu.cn
SJTU_VPN_RIGHTSUBNET=0.0.0.0/0
SJTU_VPN_LEFTAUTH=eap-peap
SJTU_VPN_RIGHTAUTH=pubkey
SJTU_VPN_USER=your_jaccount_username
SJTU_VPN_PASSWORD=your_password
