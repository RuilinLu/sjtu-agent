# Copy to deploy/clawbot-vpn/.env in Portainer.
# Do not commit the real .env.

# OpenClaw container. If you run OpenClaw outside this compose stack, leave the
# openclaw profile disabled and configure it to call http://sjtu-vpn:8765/sse
# from the same Docker network, or tunnel to the MCP endpoint.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# Optional push webhook exposed by your OpenClaw deployment. If not configured,
# reminders still work as queryable MCP data; proactive ClawBot push is disabled.
OPENCLAW_PUSH_URL=
OPENCLAW_PUSH_TOKEN=
OPENCLAW_PUSH_TO=

# SJTU student VPN.
SJTU_VPN_SERVER=stuv4.vpn.sjtu.edu.cn
SJTU_VPN_ID=@stu.vpn.sjtu.edu.cn
SJTU_VPN_RIGHTSUBNET=0.0.0.0/0
SJTU_VPN_LEFTAUTH=eap-peap
SJTU_VPN_RIGHTAUTH=pubkey
SJTU_VPN_USER=your-jaccount-username
SJTU_VPN_PASSWORD=your-jaccount-password

# SJTU Agent runtime credentials.
SJTU_AGENT_HOME=/data/sjtu-agent
JACCOUNT_USERNAME=your-jaccount-username
JACCOUNT_PASSWORD=your-jaccount-password

# Zhiyuan-1 model API.
ZHIYUAN_API_KEY=your-zhiyuan-api-key
ZHIYUAN_BASE_URL=https://models.sjtu.edu.cn/api/v1
ZHIYUAN_MODEL=deepseek-chat

# Background jobs.
REMIND_INTERVAL_SECONDS=60
DAILY_REPORT_TIME=08:00
